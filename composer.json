{
    "name": "infocyph/intermix",
    "description": "A lightweight, high-performance PHP dependency injection and runtime utility toolkit with invocation, scoped services, compiled resolution, Closure serialization, Fence and fluent helpers.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "intermix",
        "di",
        "container",
        "dependency-injection",
        "psr-11",
        "invoker",
        "closure-serialization",
        "attributes",
        "scoped-services",
        "macro",
        "mixin",
        "cache",
        "reflection"
    ],
    "authors": [
        {
            "name": "Infocyph",
            "email": "infocyph@gmail.com"
        },
        {
            "name": "abmmhasan",
            "email": "abmmhasan@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "opis/closure": "^4.5",
        "psr/cache": "^3.0",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "infocyph/cachelayer": "^3.2.0",
        "infocyph/phpforge": "dev-main@dev"
    },
    "suggest": {
        "ext-mbstring": "Recommended for development tools output formatting (Pest/Termwind)",
        "infocyph/cachelayer": "Recommended PSR-6 cache implementation with memory, APCu, SQLite, Redis/Valkey, tiered and node-local adapters"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Infocyph\\InterMix\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Infocyph\\InterMix\\Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "/tests/**/*Test.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infocyph/phpforge": true,
            "pestphp/pest-plugin": true
        },
        "classmap-authoritative": true,
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "ic:bench:quick": "@php vendor/bin/phpbench run benchmarks/CompiledRuntimeBench.php --report=aggregate"
    }
}
